# ============================================================
#  SecureChat — Environment Variables
#  Осы файлды .env деп атап, нақты мәндерді толтырыңыз.
#  .env файлын GitHub-қа commit ЕТПЕҢІЗ!
# ============================================================

# 🔐 AES-256-GCM шифрлау кілті (32 байт, Base64)
# Жасау үшін: openssl rand -base64 32
ENCRYPTION_KEY=мұнда_openssl_rand_-base64_32_нәтижесін_қойыңыз

# 🔑 JWT кілті (кем дегенде 32 символ)
JWT_SECRET=өте_ұзын_және_кездейсоқ_jwt_кілті_міне

# 🗄 Дерекқор паролі
DB_PASSWORD=SecureChat2026!
